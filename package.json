{
	"name": "@acdh-oeaw/youbeon-frontend",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		}
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite --port 3000",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:db": "tsx ./scripts/generate-db/index.ts",
		"generate:favicons": "tsx ./scripts/generate-favicons.ts",
		"generate:imprint": "tsx ./scripts/generate-imprint.ts",
		"lint:check": "pnpm run \"/^lint:[a-z]+:check/\"",
		"lint:fix": "pnpm run \"/^lint:[a-z]+:fix/\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:styles:check": "stylelint \"**/*.@(css|html|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"prepare": "pnpm run setup && pnpm run --sequential \"/^generate:/\"",
		"setup": "is-ci || lefthook install",
		"start": "vite preview --port 3000",
		"test": "exit 0",
		"types:check": "vue-tsc",
		"validate": "pnpm run format:check && pnpm run lint:check && pnpm run types:check && pnpm run test"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@fontsource-variable/noto-sans-display": "^5.3.0",
		"@headlessui/tailwindcss": "^0.2.2",
		"@headlessui/vue": "insiders",
		"@heroicons/vue": "^2.2.0",
		"@stefanprobst/object": "^1.2.0",
		"d3": "^7.9.2",
		"force-graph": "1.46.0",
		"maplibre-gl": "^6.19.0",
		"nprogress": "^0.2.0",
		"sharp": "^0.35.5",
		"vue": "^3.5.46",
		"vue-router": "^5.5.1"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@stefanprobst/favicons": "^2.4.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.6",
		"@types/nprogress": "^0.2.3",
		"@types/serialize-javascript": "^5.0.4",
		"@vitejs/plugin-vue": "^6.0.11",
		"eslint-plugin-regexp": "^3.3.3",
		"is-ci": "^4.1.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"serialize-javascript": "^7.1.4",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vite-imagetools": "^12.0.2",
		"vue-tsc": "^3.3.14",
		"xlsx": "^0.18.5"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}
